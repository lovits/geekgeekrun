<mxfile><diagram name="模型输入流程"><mxGraphModel dx="1100" dy="900" grid="1" page="1" pageWidth="1100" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="user" value="你的资料与设置&#10;简历、偏好、反馈、求职类型、正则、页面条件、公司规则、活跃度&#10;仅勾选项进入模型" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#86efac;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="440" height="150" as="geometry" /></mxCell><mxCell id="boss" value="BOSS 岗位信息&#10;按 AI 范围提供名称／描述；公司、城市、职位类型等基础信息&#10;活跃状态随开关；薪资原文不发送" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#86efac;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="440" height="150" as="geometry" /></mxCell><mxCell id="merge" value="组合已启用输入&#10;匹配提示词 + 固定审核规则" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#86efac;" vertex="1" parent="1"><mxGeometry x="170" y="290" width="210" height="100" as="geometry" /></mxCell><mxCell id="match" value="AI 理解与匹配&#10;职责、技能、资格与偏好" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#86efac;" vertex="1" parent="1"><mxGeometry x="440" y="290" width="210" height="100" as="geometry" /></mxCell><mxCell id="result" value="评分、结论、依据、差异&#10;程序结合启用规则作最终判断" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#86efac;" vertex="1" parent="1"><mxGeometry x="710" y="290" width="270" height="100" as="geometry" /></mxCell><mxCell id="edge0" edge="1" source="user" target="merge" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" edge="1" source="boss" target="merge" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" edge="1" source="merge" target="match" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" edge="1" source="match" target="result" parent="1" style="edgeS